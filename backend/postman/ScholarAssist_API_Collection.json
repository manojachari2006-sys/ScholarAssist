{
  "info": {
    "name": "ScholarAssist API Collection",
    "description": "Core development API. These endpoints are unauthenticated and use explicit IDs for local testing. Run after configuring a seeded userId and a valid PDF/JPEG/PNG uploadFile. Suggested flow: create profile, create scholarship, evaluate eligibility, upload document, create application, associate and submit the document, submit application, update status, then read notifications.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Student Profiles",
      "item": [
        {
          "name": "Create student profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/student-profile/{{userId}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Student\",\n  \"phone\": \"9876543210\",\n  \"dateOfBirth\": \"2004-03-12\",\n  \"gender\": \"Female\",\n  \"state\": \"Karnataka\",\n  \"district\": \"Mysuru\",\n  \"collegeName\": \"Test University\",\n  \"course\": \"BSc\",\n  \"yearOfStudy\": 2,\n  \"cgpa\": 8.4,\n  \"annualFamilyIncome\": 250000,\n  \"category\": \"OBC\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Response is valid JSON\", function () { pm.response.to.be.json; });",
                  "if (pm.response.code >= 200 && pm.response.code < 300) { const body = pm.response.json(); pm.expect(body.id).to.exist; pm.environment.set(\"studentId\", body.id); }"
